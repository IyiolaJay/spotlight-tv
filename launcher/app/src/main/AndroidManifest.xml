<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Usage access, granted over ADB (appops GET_USAGE_STATS): "Last opened" under the card, and
         spotting the power-on Live TV launch. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Never draws overlays; granted over ADB, it lets Home come back in front of the Live TV that
         UK firmware starts at power-on (Android blocks activity starts from the background otherwise). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android only reveals the Wi-Fi name to apps with location; granted over ADB, never asked for. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ package visibility: without these the app list comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
        <!-- The Wi-Fi and Settings menus only list screens the TV's Settings app has -->
        <package android:name="com.android.tv.settings" />
    </queries>

    <!-- directBootAware: Android starts this Home from the first seconds of boot, instead of its own
         placeholder, so it is already running when the firmware forces Live TV (see HomeActivity) -->
    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Favourites / hidden apps over ADB. DUMP is held by the shell, not by apps. -->
        <receiver
            android:name=".ConfigReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.iyiolajay.spotlight.CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
